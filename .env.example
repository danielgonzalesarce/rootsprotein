NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_GA_ID=

# Link “Pedir reseñas” del Perfil de Empresa de Google (recomendado)
# NEXT_PUBLIC_GOOGLE_REVIEW_URL=https://g.page/r/XXXX/review

# --- Secretos (obligatorios en producción / Vercel) ---
# Genera valores largos y únicos. NUNCA subas .env.local al repo.
# Ejemplo: openssl rand -base64 32
LOYALTY_SECRET=cambia-esta-clave-larga-min-16
LOYALTY_QR_SECRET=cambia-esta-otra-clave-min-16
LOCAL_QR_PASSWORD=clave-local-min-8

# Reseñas del sitio: por defecto quedan pendientes de moderación
# SITE_REVIEWS_AUTO_PUBLISH=true

# Neon Postgres — normalmente las pone `neon deploy` en .env.local
# (si faltan, en local se usa .data/loyalty.json)
DATABASE_URL=postgresql://usuario:clave@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=
